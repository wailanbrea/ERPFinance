APP_NAME="ERP Bsolutions Finanzas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.example.com
ASSET_URL=https://erp.example.com
APP_TIMEZONE=America/Santo_Domingo
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

ERP_PLAN=full
DEMO_ENABLED=false
DEMO_USER_EMAIL=admin@erp-bsolutions.local
DEMO_USER_ROLE="Plan Full"
ALLOW_PUBLIC_REGISTRATION=false
SUPERADMIN_OWNER_EMAIL=owner@example.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_bsolutions_finanzas
DB_USERNAME=erp_bsolutions
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=finanzas@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
